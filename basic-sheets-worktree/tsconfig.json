{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["client/**/*.ts", "shared/**/*.ts", "vite.config.ts"]
}
