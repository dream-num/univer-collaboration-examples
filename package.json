{
  "name": "univer-collaboration-examples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "example:quick-start": "pnpm --filter @univerjs/collaboration-example-quick-start build && pnpm --filter @univerjs/collaboration-example-quick-start start",
    "example:database-adapter": "pnpm --filter @univerjs/collaboration-example-database-adapter build && pnpm --filter @univerjs/collaboration-example-database-adapter start",
    "example:permissions": "pnpm --filter @univerjs/collaboration-example-permissions build && pnpm --filter @univerjs/collaboration-example-permissions start",
    "example:history": "pnpm --filter @univerjs/collaboration-example-history build && pnpm --filter @univerjs/collaboration-example-history start",
    "example:comments": "pnpm --filter @univerjs/collaboration-example-comments build && pnpm --filter @univerjs/collaboration-example-comments start",
    "example:worktree": "pnpm --filter @univerjs/collaboration-example-worktree build && pnpm --filter @univerjs/collaboration-example-worktree start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
