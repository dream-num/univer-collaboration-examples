{
  "name": "@univerjs/collaboration-tool-universer-migration",
  "version": "0.0.0",
  "private": true,
  "description": "Migrates Universer data into the Univer Collaboration PostgreSQL + S3 database adapter",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@msgpack/msgpack": "^3.1.3",
    "@univerjs-pro/collaboration-comment-database-postgres": "1.6.2",
    "@univerjs-pro/collaboration-database-postgres-s3": "1.6.2",
    "@univerjs-pro/collaboration-file-database-postgres": "1.6.2",
    "@univerjs-pro/collaboration-file-service": "1.6.2",
    "@univerjs-pro/collaboration-service": "1.6.2",
    "@univerjs/protocol": "1.6.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
